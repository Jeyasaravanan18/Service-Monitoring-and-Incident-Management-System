# ============================================================
# SMIMP Frontend (Client) Environment Variables
# ============================================================

# The URL of your backend REST API (must end with /api)
# Local development default: http://127.0.0.1:4000/api
# Production default (if unset): https://smimp-backend.onrender.com/api
VITE_API_BASE=https://smimp-backend.onrender.com/api

# The URL of your backend Socket.IO WebSocket server (root URL, no /api)
# Local development default: http://127.0.0.1:4000
# Production default (if unset): https://smimp-backend.onrender.com
VITE_SOCKET_URL=https://smimp-backend.onrender.com
